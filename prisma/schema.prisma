generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum ServiceUnit {
  KG
  ITEM
}

enum OrderStatus {
  DRAFT
  PICKUP_SCHEDULED
  PICKED_UP
  PROCESSING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
}

enum PaymentMethod {
  QRIS
}

// ==========================================
// MODELS
// ==========================================

model Profile {
  id        String   @id
  email     String   @unique
  fullName  String?
  phone     String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses       Address[]
  orders          Order[]              @relation("CustomerOrders")
  statusHistories OrderStatusHistory[] @relation("StatusHistoryCreatedBy")
  deviceTokens    DeviceToken[]

  @@map("profiles")
}

model Address {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String
  recipientName String?
  phone         String?
  line          String
  city          String?
  postalCode    String?
  note          String?
  isDefault     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pickupOrders   Order[] @relation("PickupAddress")
  deliveryOrders Order[] @relation("DeliveryAddress")

  @@index([userId])
  @@map("addresses")
}

model Service {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  description String?
  unit        ServiceUnit
  price       Decimal     @db.Decimal(12, 2)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  orderItems OrderItem[]

  @@map("services")
}

model Order {
  id          String  @id @default(uuid()) @db.Uuid
  orderNumber String  @unique
  customerId  String
  customer    Profile @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)

  status        OrderStatus   @default(DRAFT)
  paymentStatus PaymentStatus @default(PENDING)

  pickupAddressId   String? @db.Uuid
  deliveryAddressId String? @db.Uuid

  pickupAddress   Address? @relation("PickupAddress", fields: [pickupAddressId], references: [id], onDelete: SetNull)
  deliveryAddress Address? @relation("DeliveryAddress", fields: [deliveryAddressId], references: [id], onDelete: SetNull)

  pickupAddressLine   String?
  deliveryAddressLine String?

  pickupScheduleAt   DateTime?
  deliveryScheduleAt DateTime?

  notes String?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)

  paidAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  items           OrderItem[]
  statusHistories OrderStatusHistory[]
  payments        Payment[]

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  serviceId String  @db.Uuid
  service   Service @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  name      String
  unit      ServiceUnit
  unitPrice Decimal     @db.Decimal(12, 2)
  quantity  Decimal     @db.Decimal(10, 3)
  subtotal  Decimal     @db.Decimal(12, 2)
  notes     String?
  createdAt DateTime    @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  status OrderStatus
  note   String?

  createdById String?
  createdBy   Profile? @relation("StatusHistoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_status_histories")
}

model Payment {
  id      String @id @default(uuid()) @db.Uuid
  orderId String @db.Uuid
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  amount Decimal       @db.Decimal(12, 2)
  method PaymentMethod @default(QRIS)
  status PaymentStatus @default(PENDING)

  expiresAt DateTime?
  paidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([status])
  @@index([expiresAt])
  @@map("payments")
}

model DeviceToken {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String
  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String  @unique
  platform String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("device_tokens")
}
